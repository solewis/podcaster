<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat colour, full-bleed.

    Full-bleed rather than a drawn circle because an adaptive icon is already masked to the
    launcher's shape - so the mask *is* the edge, crisp at every size and correct on a circle, a
    squircle or a teardrop without redrawing anything.

    No gradient. An earlier version shaded this into a sphere, which was the right idea for an icon
    trying to look like a real object and the wrong one for a flat mark, where it just muddies the
    single colour the icon is recognised by. #4B6088 is the app's own primary (see ui/theme/Color.kt).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#FF4B6088" android:pathData="M0,0h108v108h-108z" />
</vector>
