<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared explicitly even though OkHttp/Coil's own manifests already merge this in -
         self-documenting, and doesn't rely on a transitive dependency continuing to declare it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read-only, and only to answer "is there a usable connection" before starting playback, so
         a tap with no signal fails immediately instead of hanging inside ExoPlayer's retries. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Episode downloads. Unlike media playback, dataSync carries a daily runtime budget on
         Android 14+ and needs its own justification in the Play Console. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".PodcasterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podcaster">

        <!-- Phone-projected Android Auto (not native Automotive OS, which uses the different
             com.android.automotive key). Points at the same "media" capability descriptor. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Podcaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- No POST_NOTIFICATIONS request: media sessions are exempt from notification
             consent on Android 13+, verified before building this - the notification still
             shows without it. -->
        <service
            android:name=".player.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- Legacy discovery action - Android Auto and older browser clients still look
                     for this alongside the Media3 action. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Not exported: nothing outside the app has any business starting downloads. The RESTART
             action is how Media3's own scheduler brings this back after the process dies or the
             network returns - without the intent-filter, an interrupted download never resumes. -->
        <service
            android:name=".download.PodcastDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>

</manifest>
